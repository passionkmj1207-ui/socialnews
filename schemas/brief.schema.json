{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/passionkmj1207-ui/socialnews/schemas/brief.schema.json",
  "title": "기획서 (brief)",
  "description": "2단계 산출물. 비서실장이 주제·핵심 질문·차별화 포인트를 확정한다. 지침서 Ⅳ 참조.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "topic",
    "article_type",
    "core_question",
    "differentiation",
    "keywords",
    "platform",
    "target_length"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*$",
      "description": "작업 식별자. 예: 20261104-oil-shipbuilding"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "주제 한 줄"
    },
    "topic_selection_reason": {
      "type": "string",
      "description": "사용자가 주제를 주지 않아 비서실장이 직접 선정한 경우에만 기록하는 선정 사유 한 줄"
    },
    "article_type": {
      "type": "string",
      "enum": ["issue_explainer", "company_earnings", "policy", "market_trend", "other"],
      "description": "이슈 해설 / 기업·실적 / 정책·제도 / 시장 동향 / 기타"
    },
    "core_question": {
      "type": "string",
      "minLength": 1,
      "description": "독자가 궁금해할 핵심 질문 한 문장. 제목·도입·본문·결론까지 유지된다."
    },
    "hypothesis": {
      "type": "string",
      "description": "한 줄 답(가설). 자료 수집 후 확인·수정한다."
    },
    "differentiation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_type", "statement"],
      "properties": {
        "question_type": {
          "type": "string",
          "enum": [
            "overlooked_point",
            "surface_vs_real_impact",
            "decision_change",
            "market_assumption",
            "other_variable",
            "indicator_to_watch"
          ],
          "description": "지침서 Ⅷ의 질문 6개 중 선택. 놓친 점 / 표면 vs 실제 영향 / 의사결정 변화 / 시장 기대의 전제 / 함께 볼 변수 / 확인할 지표"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "차별화 포인트 한 문장"
        }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "related"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "related": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "search_volume": {
          "type": "string",
          "default": "unverified",
          "description": "확인 가능한 도구·자료가 있을 때만 값을 적고, 없으면 unverified. 추정치 금지."
        }
      }
    },
    "platform": {
      "type": "string",
      "enum": ["naver_blog", "tistory"],
      "default": "naver_blog"
    },
    "target_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_chars", "max_chars"],
      "properties": {
        "min_chars": { "type": "integer", "minimum": 500, "default": 2500 },
        "max_chars": { "type": "integer", "minimum": 500, "default": 4000 }
      },
      "description": "공백 제외 글자 수 범위. 기본값 2,500~4,000자."
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "비어 있던 정보를 채우기 위해 적용한 가정. 사용자 보고에 그대로 옮겨진다."
    },
    "skipped_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "reason"],
        "properties": {
          "section": { "type": "integer", "minimum": 1, "maximum": 7 },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "description": "생략하거나 다른 단계에 통합한 표준 구성 단계(1~7)와 그 이유"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "note"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      },
      "description": "기획 변경 이력. 핵심 질문에 답할 수 없음이 확인된 경우에 한해 1회만 허용."
    }
  }
}
