{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/passionkmj1207-ui/socialnews/schemas/publish_info.schema.json",
  "title": "발행 관리 정보 (publish_info)",
  "description": "7단계 산출물. 검수를 통과한 원고를 기준으로 발행정보 에이전트가 작성한다. 지침서 Ⅹ-B 참조.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "primary_keyword",
    "related_keywords",
    "search_intent",
    "meta_description",
    "alt_titles",
    "sources",
    "needs_verification"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "primary_keyword": { "type": "string", "minLength": 1 },
    "related_keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "search_intent": { "type": "string", "minLength": 1 },
    "meta_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "alt_titles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "description": "대안 제목 2개"
    },
    "internal_link_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "description": "기존 글 목록이 제공된 경우의 경로" }
        }
      },
      "description": "기존 글 목록이 제공된 경우에만 연결 후보를 적는다."
    },
    "followup_topics": {
      "type": "array",
      "items": { "type": "string" },
      "description": "기존 글 목록이 없을 때 internal_link_candidates 대신 제안하는 연결 후속 주제"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "base_date"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "base_date": { "type": "string", "minLength": 1 }
        }
      },
      "description": "팩트시트 중 본문에 실제로 사용한 출처만"
    },
    "needs_verification": {
      "type": "array",
      "items": { "type": "string" },
      "description": "추가 검증 필요 항목. 없으면 빈 배열"
    },
    "platform_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "title", "structure_note"],
        "properties": {
          "platform": { "type": "string", "enum": ["naver_blog", "tistory"] },
          "title": { "type": "string", "minLength": 1 },
          "structure_note": { "type": "string", "minLength": 1 }
        }
      },
      "description": "사용자가 요청한 경우에만 작성하는 플랫폼별 조정안"
    }
  }
}
