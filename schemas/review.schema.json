{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/passionkmj1207-ui/socialnews/schemas/review.schema.json",
  "title": "검수 리포트 (review)",
  "description": "5단계 산출물. 작성자와 분리된 검수가 팩트시트를 기준으로 게이트 A(Pass/Fail)와 게이트 B(점수)를 판정한다. 지침서 Ⅳ·Ⅸ 참조.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "round", "gate_a", "scores", "total", "fix_instructions", "verdict"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 초안 검수 / 2 1차 수정 후 재검수 / 3 2차 수정 후 재검수. 수정은 최대 2회."
    },
    "gate_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlisted_figures",
        "false_source",
        "unit_or_date_error",
        "logic_error",
        "forecast_assertion",
        "question_mismatch"
      ],
      "properties": {
        "unlisted_figures": { "$ref": "#/$defs/gate" },
        "false_source": { "$ref": "#/$defs/gate" },
        "unit_or_date_error": { "$ref": "#/$defs/gate" },
        "logic_error": { "$ref": "#/$defs/gate" },
        "forecast_assertion": { "$ref": "#/$defs/gate" },
        "question_mismatch": { "$ref": "#/$defs/gate" }
      },
      "description": "unlisted_figures: 팩트시트에 없거나 사용 불가인 수치·인용 / false_source: 허위·미확인 출처 / unit_or_date_error: 단위·기준일·비교 대상 오류 / logic_error: 중대한 논리 오류 / forecast_assertion: 전망·실적·주가 예측 단정 / question_mismatch: 핵심 질문과 본문 불일치"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy",
        "seo_fit",
        "clarity",
        "engagement",
        "causal_logic",
        "originality",
        "practical_value",
        "prose_quality"
      ],
      "properties": {
        "accuracy": { "$ref": "#/$defs/score" },
        "seo_fit": { "$ref": "#/$defs/score" },
        "clarity": { "$ref": "#/$defs/score" },
        "engagement": { "$ref": "#/$defs/score" },
        "causal_logic": { "$ref": "#/$defs/score" },
        "originality": { "$ref": "#/$defs/score" },
        "practical_value": { "$ref": "#/$defs/score" },
        "prose_quality": { "$ref": "#/$defs/score" }
      },
      "description": "사실 정확성 / 검색 의도·SEO / 명료성 / 흥미·몰입 / 인과 논리 / 독창성 / 실질적 가치 / 문장 완성도 (각 5점)"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40,
      "description": "scores 합계. validate.py가 합계 일치를 확인한다."
    },
    "fix_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "problem", "direction", "origin"],
        "properties": {
          "location": { "type": "string", "minLength": 1, "description": "소제목 또는 문단·문장 위치" },
          "problem": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "minLength": 1 },
          "origin": {
            "type": "string",
            "description": "gate_a 키 이름 또는 scores 키 이름",
            "enum": [
              "unlisted_figures",
              "false_source",
              "unit_or_date_error",
              "logic_error",
              "forecast_assertion",
              "question_mismatch",
              "accuracy",
              "seo_fit",
              "clarity",
              "engagement",
              "causal_logic",
              "originality",
              "practical_value",
              "prose_quality"
            ]
          }
        }
      },
      "description": "게이트 A Fail 항목과 4점 미만 항목에 대해서만 작성한다."
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "rework", "below_standard", "hold"],
      "description": "pass: 통과 / rework: 재작업 / below_standard: 2회 수정 후에도 점수 미달, 표시하고 보고 / hold: 게이트 A 문제 미해소로 발행 보류"
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass"],
      "properties": {
        "pass": { "type": "boolean" },
        "locations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fail인 경우 문장 위치"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "reason": { "type": "string", "minLength": 1, "description": "한 줄 근거" }
      }
    }
  }
}
