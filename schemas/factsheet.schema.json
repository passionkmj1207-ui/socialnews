{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/passionkmj1207-ui/socialnews/schemas/factsheet.schema.json",
  "title": "팩트시트 (factsheet)",
  "description": "3단계 산출물. 리서치 에이전트가 자료 수집과 검증을 한 번에 수행해 작성한다. 작성 에이전트는 usable=true 항목의 수치만 본문에 쓴다. 지침서 Ⅳ·Ⅶ 참조.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "items", "counter_evidence", "unverified"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "note"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "description": "대상이 되는 핵심 인과관계" },
          "note": { "type": "string", "minLength": 1, "description": "확인한 반례 또는 전제조건" }
        }
      },
      "description": "반대 근거·예외조건"
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "description": "확인하지 못한 항목과 사유. 최신 자료에 접근하지 못한 경우도 여기에 올린다."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tier", "opened"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 정부·공공기관 / 2 전자공시·거래소·기업 공시 / 3 중앙은행·국제기구 / 4 신뢰 언론 / 5 전문가 보고서·분석자료"
        },
        "opened": {
          "type": "boolean",
          "description": "원문을 직접 열어 해당 수치를 확인했는가"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "content", "sources", "original_checked", "grade", "usable"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "kind": {
          "type": "string",
          "enum": ["fact", "interpretation_candidate"],
          "description": "사실 / 해석 후보"
        },
        "content": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "null"],
          "description": "수치. 수치가 없는 항목은 null"
        },
        "unit": { "type": ["string", "null"] },
        "comparison_basis": {
          "type": ["string", "null"],
          "description": "비교 기준. 예: 전년 동기 대비, 전월 대비"
        },
        "scope": {
          "type": ["string", "null"],
          "description": "통계의 대상과 산출 방식"
        },
        "base_date": {
          "type": ["string", "null"],
          "description": "기준일·발표일. 예: 2026-10-31, 2026-09"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "original_checked": {
          "type": "boolean",
          "description": "1~3순위 출처의 원문을 직접 확인했는가"
        },
        "grade": {
          "type": "string",
          "enum": ["core", "supporting"],
          "description": "core: 제목·결론·인과 설명의 근거가 되는 수치 / supporting: 맥락 보충"
        },
        "usable": {
          "type": "boolean",
          "description": "본문 사용 가능 여부. 검증에 실패했거나 원문 미확인+출처 1곳뿐이면 false."
        },
        "note": { "type": "string" }
      }
    }
  }
}
